# Server
PORT=3000
# على Render لازم: NODE_ENV=production
NODE_ENV=development

# Session
SESSION_SECRET=change-this-to-a-strong-random-string-min-32-characters

# Database
# على Render: اربط Persistent Disk واستخدم DB_PATH=/var/data/huda.db
DB_PATH=./data/huda.db

# CORS
CLIENT_URL=https://huda-app1.netlify.app

# Infobip Email API
INFOBIP_BASE_URL=https://nd91q8.api.infobip.com
INFOBIP_API_KEY=rayanalgool5-infobip-key-here
INFOBIP_FROM=rayanalgool5@gmail.com
INFOBIP_REPLY_TO=rayanalgool5@gmail.com
# البريد الذي يستقبل رسائل نموذج "تواصل معي"
FEEDBACK_TO_EMAIL=rayanalgool5@gmail.com

PASSWORD_RESET_OTP_LENGTH=6
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Frontend
FRONTEND_URL=https://huda-app1.netlify.app

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=rayanalgool5@gmail.com

# Islamic assistant — REQUIRED on Render; never put the real key in frontend files or Git.
GEMINI_API_KEY=put-your-gemini-key-here
GEMINI_MODEL=gemini-3.8-flash

# Remote hadith source. The backend caches and merges the Arabic collections on startup.
HADITH_REMOTE_URL=https://api.hadith.gading.dev/books
HADITH_REMOTE_LIMIT=500

GAME_GENERATION_DAILY_LIMIT=20
