# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=change-this-to-a-strong-random-string-min-32-characters

# Database
DB_PATH=./data/huda.db

# CORS
CLIENT_URL=http://localhost:3000

# Infobip Email API
INFOBIP_BASE_URL=https://YOUR-BASE-URL.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_FROM=verified-sender@example.com
INFOBIP_REPLY_TO=verified-sender@example.com

# Email verification + Password reset / Email OTP
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_OTP_LENGTH=6
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Frontend
FRONTEND_URL=http://localhost:3000

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Islamic assistant — configure these in Render, never in frontend files.
GEMINI_API_KEY=
# Backwards-compatible aliases accepted by the server: GOOGLE_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Remote hadith source. The backend caches and merges the Arabic collections on startup.
HADITH_REMOTE_URL=https://api.hadith.gading.dev/books
HADITH_REMOTE_LIMIT=500

GAME_GENERATION_DAILY_LIMIT=20
